# Copiar como .env y ajustar.
#
#   cp .env.example .env
#
# MODO TODO EN UNA MAQUINA
#   No hay que tocar ninguna direccion: los valores por defecto usan los nombres
#   de los contenedores, que Docker resuelve solo dentro de la red interna.
#   Basta con cambiar las claves de abajo.
#
# MODO SEIS SERVIDORES
#   En cada servidor hay que descomentar las direcciones de las plataformas de
#   las que ese servidor depende, y poner la IP PRIVADA correspondiente:
#
#     ServerWeb    necesita STOCK_HOST, AGENDA_HOST y CRM_HOST
#     ServerPagos  necesita GATEWAY_HOST (queda en la misma maquina)
#     ServerBorde  necesita las cinco: WEB, STOCK, AGENDA, CRM y PAGOS
#     Todos los que usan base de datos necesitan DB_HOST
#
#   Se usa la IP PRIVADA a proposito: en AWS se conserva cuando la instancia se
#   detiene y se vuelve a encender, mientras que la publica cambia.

# --- Credenciales -----------------------------------------------------------
DB_NAME=andysmotors
DB_USER=andysadmin
DB_PASSWORD=CambiaEste.Password_123

# Token para encender y apagar los escenarios de falla.
ANDYS_ADMIN_TOKEN=andys-lab

# --- Direcciones (solo para el modo de seis servidores) ---------------------
# DB_HOST=10.0.1.20
# WEB_HOST=10.0.1.10
# STOCK_HOST=10.0.1.11
# AGENDA_HOST=10.0.1.12
# CRM_HOST=10.0.1.13
# PAGOS_HOST=10.0.1.14
# GATEWAY_HOST=gateway-externo

# --- Puertos (normalmente no se tocan) --------------------------------------
# Cada plataforma usa el mismo puerto dentro y fuera del contenedor, para que
# la direccion sea identica en los dos modos de despliegue.
# WEB_PORT=8081
# STOCK_PORT=8082
# AGENDA_PORT=8083
# CRM_PORT=8084
# PAGOS_PORT=8085
# GATEWAY_PORT=8086
# DB_PORT=5432
# Puerto publicado en el host para PostgreSQL. Cambialo si la maquina ya tiene
# un PostgreSQL propio escuchando en el 5432.
# DB_PUBLISH_PORT=5432
