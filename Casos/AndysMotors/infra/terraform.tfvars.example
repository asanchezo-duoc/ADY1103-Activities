# Copiar este archivo como terraform.tfvars y completar los valores.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars NO se versiona (ver .gitignore): contiene passwords.

# --- Obligatorio ------------------------------------------------------------

# IP publica propia, en formato CIDR /32. Obtenerla con:  curl -s ifconfig.me
# Es el unico origen que podra entrar por SSH, Grafana y Prometheus.
admin_cidr = "TU.IP.PUBLICA.AQUI/32"

# Entre 12 y 41 caracteres. Solo letras, numeros, _ . ~ y -
db_password            = "CambiaEste.Password_123"
grafana_admin_password = "CambiaEste.Grafana_123"

# --- Opcional (estos son los valores por defecto) ---------------------------

# aws_region        = "us-east-1"
# project_name      = "andys-motors"
# key_name          = "vockey"
# instance_type     = "t3.micro"
# root_volume_size  = 20

# Segunda instancia con Prometheus + Grafana.
# Ponerlo en false para un primer apply mas corto.
# enable_monitoring = true

# Abrir el puerto 80 a Internet (comportamiento real de un sitio publico).
# En el laboratorio conviene dejarlo en false: solo entra admin_cidr.
# allow_public_web  = false

# Amazon RDS real en vez del contenedor PostgreSQL.
# Leer la advertencia de la seccion "RDS" del README antes de encenderlo:
# tarda entre 10 y 15 minutos y consume presupuesto.
# enable_rds        = false
# db_instance_class = "db.t3.micro"
# db_name           = "andysmotors"
# db_username       = "andysadmin"
