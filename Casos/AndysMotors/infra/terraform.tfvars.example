# Copiar este archivo como terraform.tfvars y completar los valores.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars NO se versiona (ver .gitignore): contiene passwords.

# --- Obligatorio ------------------------------------------------------------

# IP publica propia, en formato CIDR /32. Obtenerla con:  curl -s ifconfig.me
# Es el unico origen que podra entrar por SSH, Grafana y Prometheus.
admin_cidr = "TU.IP.PUBLICA.AQUI/32"

# Entre 12 y 41 caracteres. Solo letras, numeros, _ . ~ y -
db_password            = "CambiaEste.Password_123"
grafana_admin_password = "CambiaEste.Grafana_123"

# Token que protege el panel de inyeccion de fallas de cada plataforma.
admin_token = "andys-lab"

# --- Opcional (estos son los valores por defecto) ---------------------------

# Como se reparten las plataformas entre servidores:
#   "completa"  una maquina por plataforma del caso (6 servidores + balanceador)
#   "compacta"  todas las plataformas en una maquina (1 servidor + balanceador)
# El entorno desplegado es identico; cambia solo el reparto.
# topologia = "completa"

# aws_region        = "us-east-1"
# project_name      = "andys-motors"
# key_name          = "vockey"
# instance_type     = "t3.micro"
# root_volume_size  = 20

# Instancia adicional con Prometheus + Grafana YA configurados, como referencia.
#
# Si el ejercicio es que el estudiante construya su propio stack de monitoreo,
# hay que ponerlo en FALSE: el entorno solo expone telemetria, y recolectarla es
# justamente el trabajo.
# enable_monitoring = true

# Abrir el puerto 80 del balanceador a Internet (comportamiento real de un sitio
# publico). En el laboratorio conviene dejarlo en false: solo entra admin_cidr.
# allow_public_web  = false

# Amazon RDS real en vez del contenedor PostgreSQL de ServerData.
# Leer la advertencia de la seccion "RDS" del README antes de encenderlo:
# tarda entre 10 y 15 minutos y consume presupuesto.
# enable_rds        = false
# db_instance_class = "db.t3.micro"
# db_name           = "andysmotors"
# db_username       = "andysadmin"
