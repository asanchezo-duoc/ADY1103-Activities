#!/bin/bash
# ---------------------------------------------------------------------------
# Arranque de un servidor de la plataforma Andys Motors.
#
# El mismo script sirve para los siete roles. Lo que cambia es la variable
# PERFILES, que decide que plataformas levanta esta maquina:
#
#   data    base de datos central
#   stock   consulta de stock de vehiculos
#   agenda  agendamiento de visitas
#   crm     CRM y sistema de ventas
#   pagos   sistema de pagos y proveedor externo
#   web     sitio web publico
#   borde   balanceador HAProxy
#
# El codigo del entorno se descarga directamente desde GitHub: el repositorio
# es publico, asi que esta maquina baja el tarball de la rama o commit indicados
# y extrae solo la carpeta demo/. No hace falta S3 ni credenciales de AWS.
#
# Los logs de este script quedan en /var/log/cloud-init-output.log
# ---------------------------------------------------------------------------
set -euxo pipefail

PERFILES="${perfiles}"
DESTINO=/opt/andys
COMPOSE_VERSION=v2.29.7

# --- 1. Dependencias --------------------------------------------------------
dnf update -y
dnf install -y docker tar gzip
systemctl enable --now docker
usermod -aG docker ec2-user

CLI_PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$CLI_PLUGINS"
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o "$CLI_PLUGINS/docker-compose"
chmod +x "$CLI_PLUGINS/docker-compose"

# --- 2. Descargar el entorno ------------------------------------------------
# GitHub entrega el repositorio completo como tar.gz; se extrae unicamente la
# carpeta del entorno. El primer componente de la ruta dentro del tarball es
# "<repo>-<ref>" y cambia segun la rama o commit, por eso se usa un comodin.
REPO_URL="${repo_url}"
REPO_REF="${repo_ref}"
REPO_SUBDIR="${repo_subdir}"
PROFUNDIDAD=$(( $(echo "$REPO_SUBDIR" | tr -cd '/' | wc -c) + 2 ))

mkdir -p "$DESTINO"
curl -fsSL --retry 5 --retry-delay 10 "$REPO_URL/archive/$REPO_REF.tar.gz" -o /tmp/repo.tar.gz
tar xzf /tmp/repo.tar.gz -C "$DESTINO" --strip-components="$PROFUNDIDAD" --wildcards "*/$REPO_SUBDIR/*"
rm -f /tmp/repo.tar.gz
cd "$DESTINO"
test -f docker-compose.yml || { echo "ERROR: no se encontro $REPO_SUBDIR en $REPO_URL ($REPO_REF)"; exit 1; }

# --- 3. Configuracion -------------------------------------------------------
# El .env se genera aqui con las direcciones que Terraform ya conoce, porque las
# IP privadas se fijan por adelantado (ver locals.tf).
cat > .env <<ENV
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
ANDYS_ADMIN_TOKEN=${admin_token}

DB_HOST=${db_host}
DB_PORT=5432

WEB_HOST=${web_host}
WEB_PORT=${web_port}
STOCK_HOST=${stock_host}
STOCK_PORT=${stock_port}
AGENDA_HOST=${agenda_host}
AGENDA_PORT=${agenda_port}
CRM_HOST=${crm_host}
CRM_PORT=${crm_port}
PAGOS_HOST=${pagos_host}
PAGOS_PORT=${pagos_port}
GATEWAY_HOST=${pagos_host}
GATEWAY_PORT=8086
ENV
chmod 600 .env

# --- 4. Construir la imagen, solo si esta maquina corre aplicaciones ---------
# ServerData y ServerBorde usan imagenes oficiales (postgres y haproxy) y no
# necesitan construir nada.
if echo "$PERFILES" | grep -qE 'stock|agenda|crm|pagos|web'; then
  docker build -t andys-motors:local ./app
fi

# --- 5. Levantar los perfiles de esta maquina -------------------------------
ARGS=""
for perfil in $(echo "$PERFILES" | tr ',' ' '); do
  ARGS="$ARGS --profile $perfil"
done

# shellcheck disable=SC2086
docker compose $ARGS up -d

echo "=== ${project_name}: perfiles [$PERFILES] levantados ==="
# shellcheck disable=SC2086
docker compose $ARGS ps
