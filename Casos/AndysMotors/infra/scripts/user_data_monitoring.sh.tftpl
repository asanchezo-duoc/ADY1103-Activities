#!/bin/bash
# ---------------------------------------------------------------------------
# Instancia de MONITOREO de Andys Motors (equivalente al ServerA de EA2/Act2-1).
#
# Levanta Prometheus + Grafana y deja configurado el scraping (modelo PULL) de
# los tres exporters que corren en la instancia de aplicacion:
#
#   node       :9100  sistema operativo del host
#   nginx      :9113  sitio web, CRM y pagos
#   postgres   :9187  base de datos central
#
# La IP de la aplicacion se inyecta desde Terraform. Se usa la IP PRIVADA a
# proposito: en AWS la IP privada se conserva cuando la instancia se detiene y
# se vuelve a encender (que es justo lo que hace el Learner Lab al cerrar la
# sesion), mientras que la publica cambia.
#
# Los logs de este script quedan en /var/log/cloud-init-output.log
# ---------------------------------------------------------------------------
set -euxo pipefail

MON_DIR=/opt/monitoring
COMPOSE_VERSION=v2.29.7

# --- 1. Docker -------------------------------------------------------------
dnf update -y
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

CLI_PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$CLI_PLUGINS"
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o "$CLI_PLUGINS/docker-compose"
chmod +x "$CLI_PLUGINS/docker-compose"

mkdir -p "$MON_DIR"/prometheus "$MON_DIR"/grafana/provisioning/datasources
cd "$MON_DIR"

# --- 2. Configuracion de Prometheus ----------------------------------------
cat > prometheus/prometheus.yml <<PROM
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # Sistema operativo de la instancia de aplicacion
  - job_name: "node"
    static_configs:
      - targets: ["${app_private_ip}:9100"]
        labels:
          app: "andys-app"
          rol: "servidor-observado"

  # Sitio web publico, CRM y pagos (nginx)
  - job_name: "nginx"
    static_configs:
      - targets: ["${app_private_ip}:9113"]
        labels:
          app: "andys-web"

  # Base de datos central
  - job_name: "postgres"
    static_configs:
      - targets: ["${app_private_ip}:9187"]
        labels:
          app: "andys-db"
PROM

# --- 3. Datasource de Grafana autoprovisionado ------------------------------
cat > grafana/provisioning/datasources/datasource.yml <<'GRAFANA'
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: true
GRAFANA

# --- 4. Stack de contenedores ----------------------------------------------
cat > docker-compose.yml <<'COMPOSE'
services:
  prometheus:
    image: prom/prometheus:latest
    container_name: serverA-prometheus
    restart: unless-stopped
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--web.enable-lifecycle"
    ports:
      - "9090:9090"
    networks: [monitoring]

  grafana:
    image: grafana/grafana:latest
    container_name: serverA-grafana
    restart: unless-stopped
    depends_on: [prometheus]
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: __GRAFANA_PASSWORD__
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "3000:3000"
    networks: [monitoring]

networks:
  monitoring:
    driver: bridge

volumes:
  prometheus_data:
  grafana_data:
COMPOSE

sed -i "s|__GRAFANA_PASSWORD__|${grafana_password}|g" docker-compose.yml
chmod 600 docker-compose.yml

# --- 5. Arranque ------------------------------------------------------------
docker compose up -d

echo "=== Stack de monitoreo de ${project_name} levantado ==="
docker compose ps
